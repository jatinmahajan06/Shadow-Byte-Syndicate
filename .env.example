# ==========================================
# SHADOW BYTE SYNDICATE - FIREBASE CONFIG
# ==========================================

# 1. Firebase Client SDK Credentials
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"

# 2. Firebase Admin SDK Credentials (Server-Side Only - NEVER prefix with NEXT_PUBLIC_)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Option A: Individual credentials (Recommended for Vercel / Production platforms)
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Option B: Single-line JSON string of the service account file (Alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# 3. Local Development Emulators (Set to "true" to use local Firebase Emulator Suite)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST="127.0.0.1:5001"

# 4. Application URL & Locale
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# 5. Optional SMTP Configuration (Server notifications / Contact alerts)
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-pass"
# EMAIL_FROM="no-reply@your-domain.example"
