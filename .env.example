# ==========================================
# SHADOW BYTE SYNDICATE - ENVIRONMENT CONFIG
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:postgres@localhost:5432/shadow_byte_syndicate?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shadow_byte_syndicate?schema=public"

# Session & JWT Secret (Generate with: openssl rand -base64 32)
# Required for signing secure HTTP-only cookies
JWT_SECRET="shadow_byte_syndicate_super_secret_jwt_key_at_least_32_chars_long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Timezone (defaults to Asia/Kolkata or your club location)
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# Email Configuration (Optional in local development; when empty, emails are logged to console)
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-pass"
# EMAIL_FROM="no-reply@shadowbyte.club"

# Optional Cloud File Storage (defaults to local public uploads)
# UPLOAD_DIR="./public/uploads"
